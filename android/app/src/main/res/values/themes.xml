<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by day and dark at night (values-night). WebView reads the
         theme's isLightTheme for prefers-color-scheme, which is what the
         app's Auto theme follows. -->
    <style name="Theme.Starling" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/starling_bg</item>
        <item name="android:statusBarColor">@color/starling_bg</item>
        <item name="android:navigationBarColor">@color/starling_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">#6ea8ff</item>
    </style>

    <style name="Theme.Starling.Panic">
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
